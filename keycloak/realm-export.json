{
  "realm": "intershop-realm",
  "enabled": true,
  "clients": [
    {
      "clientId": "online-store",
      "name": "Витрина интернет-магазина",
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "online-store-secret",
      "redirectUris": [
        "http://localhost:8080/*"
      ],
      "baseUrl": "http://localhost:8080",
      "webOrigins": ["+"]
    },
    {
      "clientId": "payment-service",
      "name": "RESTful-сервис платежей",
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false,
      "serviceAccountsEnabled": false
    }
  ],
  "roles": {
    "client": {
      "online-store": [
        { "name": "ROLE_USER" },
        { "name": "ROLE_ADMIN" }
      ],
      "payment-service": [
        { "name": "ROLE_PAYMENT" }
      ]
    }
  }
}

